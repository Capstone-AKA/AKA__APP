{
  "expo": {
    "name": "ACA",
    "slug": "aca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ACA_3.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/ACA_3.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ACA_3.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.client",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "react-native-ble-plx",
      "expo-font",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "5484cd87-fd45-4b82-a70f-881a829b90bc"
      }
    }
  }
}
